+func TestFilterGroupTrigger(t *testing.T) {
+	tests := []struct {
+		name, from, body, prefix, want string
+		ok                            bool
+	}{
+		{"group accepts prefix", "123@chatroom", "0 刚喝了160", "0", "刚喝了160", true},
+		{"group accepts Chinese colon", "123@chatroom", "  0：醒了", "0", "醒了", true},
+		{"group ignores chatter", "123@chatroom", "今晚吃什么", "0", "", false},
+		{"direct message needs no prefix", "user@im.wechat", "醒了", "0", "醒了", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, ok := filterGroupTrigger(tt.from, tt.body, tt.prefix)
+			if got != tt.want || ok != tt.ok {
+				t.Fatalf("got (%q,%v), want (%q,%v)", got, ok, tt.want, tt.ok)
+			}
+		})
+	}
+}
