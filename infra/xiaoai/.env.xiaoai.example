# Xiaomi account
MI_USER=your_xiaomi_user_id
MI_PASS_TOKEN=your_xiaomi_pass_token
# MI_PASS can be used instead, but passToken avoids storing the password here.
# MI_PASS=your_xiaomi_password
MI_DID=your_xiaoai_device_did

# BabyNote's OpenAI-compatible Agent on the Windows host.
# host.docker.internal is required because this service runs in Docker.
OPENCLAW_URL=http://host.docker.internal:3000
OPENCLAW_MODEL=babynote-agent
# Must match BABYNOTE_AGENT_API_TOKEN in the BabyNote server environment.
OPENCLAW_TOKEN=

# L05C/L05B voice path
TTS_SIID=5
TTS_AIID=3
STREAM_RESPONSE=true

# Only requests beginning with one of these words are intercepted.
# Empty means intercept every recognized query.
CALL_AI_KEYWORDS=请,你

MI_DEBUG=false
MI_TIMEOUT=5000
MI_HEARTBEAT=1000
# Raw Xiaomi conversation polling interval; lower values reduce the native XiaoAi race.
MI_POLL_INTERVAL=100
MCP_PORT=3001
THINKING_TEXT=请稍候
